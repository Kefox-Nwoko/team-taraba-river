# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin SDK credentials (absolute or relative path to service account JSON)
# If blank, the app falls back to Application Default Credentials / Cloud Run service account.
GOOGLE_APPLICATION_CREDENTIALS=""

# Comma-separated list of admin emails for role elevation when custom claims are absent
ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Brevo API Key for automated birthday email reminders and sign-in codes
# (Sign up at brevo.com, verify a sender under Senders/Domains, then generate
# an API key under Settings > SMTP & API.)
BREVO_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
SENDER_EMAIL="Team Taraba River <admin@example.com>"

# Optional Google Drive & YouTube Integration Configs
GOOGLE_DRIVE_FOLDER_ID="1a2b3c4d5e6f7g8h9i0j"
YOUTUBE_API_KEY="AIzaSyYourYouTubeKey"

# YouTube channel upload credentials — SERVER-SIDE ONLY (used by server/mediaPipeline.ts
# to open resumable upload sessions with Google). Do NOT prefix these with VITE_: that
# would inline them into the public browser bundle, handing out permanent account access
# to every visitor. The browser only ever receives a single-use, self-expiring upload
# session URL from the backend — never these credentials.
YOUTUBE_CLIENT_ID="YOUR_YOUTUBE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="GOCSPX-your-client-secret"
YOUTUBE_REFRESH_TOKEN="1//09-your-refresh-token"
YOUTUBE_REDIRECT_URI="http://localhost:3000/oauth2callback"

# Optional Firestore Project ID
FIRESTORE_PROJECT_ID="Team Taraba River"


# Human verification on member registration (Cloudflare Turnstile — free).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile, add your
# site's domain, then set BOTH keys. TURNSTILE_SECRET_KEY is server-only (never give
# it a VITE_ prefix); VITE_TURNSTILE_SITE_KEY is public and is baked into the client
# at build time, so it must be set when running `npm run build`.
# Leave both blank to disable the check (local dev) — registration then relies only on
# the hidden-field / minimum-fill-time / per-IP rate-limit checks.
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""
