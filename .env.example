# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Admin SDK credentials (absolute or relative path to service account JSON)
# If blank, the app falls back to Application Default Credentials / Cloud Run service account.
GOOGLE_APPLICATION_CREDENTIALS=""

# Comma-separated list of admin emails for role elevation when custom claims are absent
ADMIN_EMAILS="admin@example.com,admin2@example.com"

# Optional Google Drive & YouTube Integration Configs
GOOGLE_DRIVE_FOLDER_ID="1a2b3c4d5e6f7g8h9i0j"
YOUTUBE_API_KEY="AIzaSyYourYouTubeKey"

# Client-side Direct Resumable Upload Credentials (Vite build-time inlined)
# These populate import.meta.env.VITE_* in the browser bundle via Vite's envPrefix.
# NEVER commit actual secret values — add them to .env only (gitignored).
VITE_YOUTUBE_CLIENT_ID="YOUR_YOUTUBE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
VITE_YOUTUBE_CLIENT_SECRET="GOCSPX-your-client-secret"
VITE_YOUTUBE_REFRESH_TOKEN="1//09-your-refresh-token"
VITE_GOOGLE_DRIVE_FOLDER_ID="YOUR_GOOGLE_DRIVE_FOLDER_ID"
VITE_GOOGLE_DRIVE_CLIENT_ID="YOUR_GOOGLE_DRIVE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_DRIVE_CLIENT_SECRET="GOCSPX-your-drive-client-secret"
VITE_GOOGLE_DRIVE_REFRESH_TOKEN="1//09-your-drive-refresh-token"

# Optional Firestore Project ID
FIRESTORE_PROJECT_ID="Team Taraba River"

