rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: The Express server uses the Firebase Admin SDK, which bypasses
    // all security rules. These rules ONLY protect against direct client-side
    // Firestore access (e.g., malicious browser scripts, Postman, etc.).

    // Helper: Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the requesting user is an admin (via custom claims or
    // verified admin email). Keep this in sync with ADMIN_EMAILS in
    // server/config.ts — there are exactly 2 admins.
    function isAdmin() {
      // .get() with defaults: a member token has no `role` (and a custom
      // token may have no `email`) claim, and reading a missing property
      // errors — which would deny rules that combine this with other checks.
      return isAuthenticated() && (
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('email', '') in ['tarabateam@gmail.com', 'xtraworxng@gmail.com']
      );
    }

    // Helper: a signed-in user who is actually on the roster (or an admin).
    // A Firebase login alone proves nothing — anyone, or any script, can mint
    // a Google account — so every "signed-in user" grant below requires a
    // members/{uid} doc, which only the server (Admin SDK) creates. This is
    // invisible to real members: registering through the form creates that doc.
    function isMember() {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/members/$(request.auth.uid))
      );
    }

    // Helper: Check if the requesting user owns this document (their
    // Firebase Auth uid matches the member document's ID — true for both
    // Google-authenticated members and code-verified members, since the
    // server mints custom tokens with uid == the member's doc ID).
    function isOwner(memberId) {
      return isAuthenticated() && request.auth.uid == memberId;
    }

    // Members collection.
    // - read: the member's own document, or an admin. Members never read each
    //   other's profiles directly — the server's business-opportunity search
    //   (Admin SDK) is the only way to look someone up. Credential matching for
    //   login also happens server-side.
    // - create: admin only. Registration goes through POST /api/members
    //   (Admin SDK), which validates and bot-checks it — a client-side create
    //   would bypass all of that.
    // - update: the member themselves, or an admin.
    // - delete: admin only.
    // - Admin accounts are not team members: no create/update may write a
    //   doc carrying an admin email, or an admin's own uid-keyed profile.
    function isAdminProfileWrite(memberId) {
      let email = request.resource.data.get('email', '');
      return (email is string && email.lower() in ['tarabateam@gmail.com', 'xtraworxng@gmail.com']) ||
        (isAdmin() && request.auth.uid == memberId);
    }

    // delete is `if false` everywhere below that has real user content —
    // every "delete" in the app now goes through the recycle bin (server
    // endpoints, Admin SDK) instead. This is what actually stops an admin
    // from bypassing the recycle bin via direct client SDK/console access;
    // the app's own UI never needed client-side delete permission anyway.
    match /members/{memberId} {
      allow read: if isOwner(memberId) || isAdmin();
      allow create: if isAdmin() && !isAdminProfileWrite(memberId);
      allow update: if (isOwner(memberId) || isAdmin()) && !isAdminProfileWrite(memberId);
      allow delete: if false;
    }

    // Deprecated legacy recycle bin — superseded by the unified
    // `recycleBin` collection below. No longer read or written anywhere.
    match /deleted_members/{entryId} {
      allow read, write: if false;
    }

    // Events collection — public read (community media galleries are
    // viewable by anonymous visitors, e.g. on mobile devices without a
    // persisted Firebase session); only admins create/update via the
    // dashboard (RSVP goes through the authenticated Express API, which
    // uses the Admin SDK, not this path).
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Photo approval requests — any signed-in member can submit one;
    // only admins decide (approve/reject) them.
    match /photoRequests/{requestId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Unified recycle bin — every deleted object of every type lands here.
    // Server-only (Admin SDK bypasses rules): restore/purge is gated to the
    // developer-admin account at the route layer in server.ts, and even a
    // regular admin's client SDK has zero access, by design.
    match /recycleBin/{entryId} {
      allow read, write: if false;
    }

    // Audit log of every delete/restore/purge — any admin can read (who did
    // what, when); never client-writable, so it can't be tampered with.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Activity logs — community feed. Any signed-in member's actions can
    // append entries; only admins bulk-edit or clear them.
    match /activityLogs/{logId} {
      allow read: if isMember();
      allow create: if isMember();
      allow update, delete: if isAdmin();
    }

    // System metrics (visit counters) — any signed-in member increments
    // these; email_config holds the Resend API key and is admin-only.
    // NOTE: Firestore ORs together every `match` block that applies to a
    // given path — a broader wildcard match does NOT get overridden by a
    // more specific sibling match, it only adds permissions on top of it.
    // So the email_config exception has to live as a condition inside this
    // one match block, not as a separate (and silently ineffective) rule.
    match /system/{metricId} {
      allow read: if metricId == 'email_config' ? isAdmin() : isMember();
      allow write: if metricId == 'email_config' ? isAdmin() : isMember();
    }

    // System config — cloud pipeline settings are admin-only, except the
    // visit-metrics mirror which any signed-in member updates. Same
    // single-match-block reasoning as system/{metricId} above.
    match /systemConfig/{configId} {
      allow read: if isMember();
      allow write: if configId == 'visit_metrics' ? isMember() : isAdmin();
    }

    // Settings (email config etc) — not used by any client code path today;
    // admin-only as a safe default. The server's own email config reads use
    // the Admin SDK and are unaffected by this rule.
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Mail queue & notification logs — not written by any client code path
    // today; admin-only so an authenticated non-admin can't send arbitrary
    // mail through the app's sender identity.
    match /mail/{mailId} {
      allow read, write: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Knowledge base articles — read by any signed-in member (AI assistant
    // context); only admins manage content.
    match /knowledgeBase/{articleId} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // Media items — server-managed (media pipeline via Admin SDK); no
    // legitimate client-side write path exists today.
    match /mediaItems/{mediaId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Short-lived sign-in codes for /api/auth/login — server-only
    // (Admin SDK), never touched by any client.
    match /loginCodes/{memberId} {
      allow read, write: if false;
    }

    // Confluence Jersey Party Feedback
    function isValidRating(val) {
      return val is int && val >= 1 && val <= 5;
    }

    function isValidTeam(team) {
      return team in ['Team Gongola', 'Team Taraba', 'Guest / Neutral'];
    }

    match /feedback/{feedbackId} {
      allow create: if 
        request.resource.data.team is string &&
        isValidTeam(request.resource.data.team) &&
        isValidRating(request.resource.data.musicRating) &&
        isValidRating(request.resource.data.foodRating) &&
        isValidRating(request.resource.data.gamesRating) &&
        isValidRating(request.resource.data.venueRating) &&
        isValidRating(request.resource.data.networkingRating) &&
        isValidRating(request.resource.data.overallRating) &&
        (!('highlight' in request.resource.data) || request.resource.data.highlight is string && request.resource.data.highlight.size() <= 1000) &&
        (!('improvements' in request.resource.data) || request.resource.data.improvements is string && request.resource.data.improvements.size() <= 1000) &&
        (!('attendeeName' in request.resource.data) || request.resource.data.attendeeName is string && request.resource.data.attendeeName.size() <= 100) &&
        (!('gradYear' in request.resource.data) || request.resource.data.gradYear is string && request.resource.data.gradYear.size() <= 30) &&
        request.resource.data.createdAt != null;
      allow read: if isMember();
      allow update, delete: if isAdmin();
    }

    // Deny all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
