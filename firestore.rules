rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: The Express server uses the Firebase Admin SDK, which bypasses
    // all security rules. These rules ONLY protect against direct client-side
    // Firestore access (e.g., malicious browser scripts, Postman, etc.).

    // Helper: Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the requesting user is an admin (via custom claims or verified admin email)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['tarabateam@gmail.com', 'kefox.nwoko@gmail.com', 'xtraworxng@gmail.com']
      );
    }


    // Helper: Check if the requesting user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Members collection — allow read for directory & credential matching; allow updates and admin deletions
    match /members/{memberId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Events collection — community events are visible and manageable
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Photo approval requests — public submission and management
    match /photoRequests/{requestId} {
      allow read, write: if true;
    }

    // Activity logs — community feed
    match /activityLogs/{logId} {
      allow read, write: if true;
    }

    // System config & metrics
    match /system/{metricId} {
      allow read, write: if true;
    }

    match /systemConfig/{configId} {
      allow read, write: if true;
    }

    // Settings (email config etc)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Mail queue & notification logs
    match /mail/{mailId} {
      allow read, write: if true;
    }

    match /notification_logs/{logId} {
      allow read, write: if true;
    }

    // Knowledge base articles
    match /knowledgeBase/{articleId} {
      allow read, write: if true;
    }

    // Media items
    match /mediaItems/{mediaId} {
      allow read, write: if true;
    }

    // Deny all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

