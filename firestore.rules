rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: The Express server uses the Firebase Admin SDK, which bypasses
    // all security rules. These rules ONLY protect against direct client-side
    // Firestore access (e.g., malicious browser scripts, Postman, etc.).

    // Helper: Check if the requesting user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if the requesting user is an admin (via custom claims or verified admin email)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.email in ['tarabateam@gmail.com', 'kefox.nwoko@gmail.com']
      );
    }

    // Helper: Check if the requesting user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Members collection — authenticated users can read, owner or admin can write
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(memberId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Events collection — authenticated users can read, admin or creator can manage
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.createdById == request.auth.uid);
    }

    // Photo approval requests — authenticated can read/submit, admin can manage
    match /photoRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Activity logs — read by authenticated, written only by server (Admin SDK)
    match /activityLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // System config & metrics — read by authenticated, written by admin or server
    match /system/{metricId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Settings (email config etc) — admin only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // Mail queue & notification logs — server only (Admin SDK)
    match /mail/{mailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Knowledge base articles — authenticated can read, admin can write
    match /knowledgeBase/{articleId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Media items — authenticated can read, server only writes (Admin SDK)
    match /mediaItems/{mediaId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Deny all other documents by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
